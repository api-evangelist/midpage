          "request": {
            "name": "Get current user",
            "description": {
              "content": "Retrieve the authenticated user's Midpage identity and current subscription status. Authenticate with a bearer token in the Authorization header. Supported bearer tokens: OAuth access token or API key. Common subscription statuses: `active`, `trialing`, `past_due`, `canceled`. If no subscription status is available, `subscriptionStatus` may be `null`.",
              "type": "text/plain"
            },
